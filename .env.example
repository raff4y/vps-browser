# Optional settings. You don't need a .env file at all: the domain, username,
# password and start page are set in the web setup wizard and the dashboard.
# Copy this to .env only if you want to change one of these.

# Timezone inside the browser (e.g. Asia/Karachi, Europe/London, America/New_York).
TZ=UTC

# Public IPv4 of the server. Detected automatically; set it only if detection fails.
#PUBLIC_IP=203.0.113.10

# acme = real HTTPS certificates (default). internal = self-signed, for local testing.
# proxy = another proxy (e.g. Coolify) does HTTPS; used by docker-compose.coolify.yml.
#TLS_MODE=acme

# Host ports, if 80/443 are already used by something else (HTTPS certificates
# need the standard ports, so only change these for local testing).
#HTTP_PORT=80
#HTTPS_PORT=443
