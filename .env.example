# Copy to .env (or just run ./setup.sh, which writes this for you).

# Domain/subdomain pointing (A record) at your VPS IP.
DOMAIN=browse.example.com

# Email for the free Let's Encrypt HTTPS certificate.
ACME_EMAIL=you@example.com

# Login for the browser page.
AUTH_USER=admin
# bcrypt hash of your password. Generate with:
#   docker run --rm caddy:2 caddy hash-password --plaintext 'your-password'
# Keep the single quotes - the hash contains $ signs.
AUTH_HASH='$2a$14$replace.me.with.a.real.hash'

# Page the browser opens on start.
START_PAGE=https://www.google.com
# Timezone inside the browser (e.g. Asia/Karachi, Europe/London).
TZ=UTC
